# .env — Instancia wsp-clientes
# Copia este archivo como .env en /var/www/wsp-clientes/

# URL base de la API puente (sin slash final)
API_BASE_URL=https://api.batidospitaya.com

# Token secreto compartido entre el VPS y la API
# Debe coincidir con WSP_TOKEN definido en la API PHP
WSP_TOKEN=c5b155ba8f6877a2eefca0183ab18e37fe9a6accde340cf5c88af724822cb50

# Puerto del servidor Express interno (no expuesto a internet)
PORT=3001

# Horario de envío (formato HH:MM, 24h, zona America/Managua)
HORA_INICIO_ENVIO=08:00
HORA_FIN_ENVIO=21:00

# Límites anti-ban
MAX_MENSAJES_DIA=30

# Pausa aleatoria ENTRE mensajes (en minutos)
# Con 30 msgs/día y pausas de 8-25 min → se distribuyen en ~4 a 12 horas
PAUSA_MIN_MINUTOS=8
PAUSA_MAX_MINUTOS=25

WSP_INSTANCIA=wsp-clientes

# ── Bypass Temporal Directo a BD Hostinger (Ajuste por bloqueo TLS VPS) ──
# true = Conexión directa a MySQL; false = Conexión estándar vía API HTTPS
USE_DIRECT_DB=true
DB_HOST=145.223.105.42
DB_PORT=3306
DB_NAME=u839374897_erp
DB_USER=u839374897_erp
DB_PASS=ERpPitHay2025$
